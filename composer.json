{
    "name": "aurora/aurora",
    "description": "Aurora CMS's admin panel theme: its styles, design tokens and prebuilt Filament theme.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.10"
    },
    "autoload": {
        "psr-4": {
            "Aurora\\Theme\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aurora\\Theme\\ThemeServiceProvider"
            ]
        }
    }
}
