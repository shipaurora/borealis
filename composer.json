{
    "name": "shipaurora/borealis",
    "description": "Borealis, Aurora CMS's default admin theme: its styles, design tokens and prebuilt Filament theme.",
    "keywords": [
        "aurora",
        "aurora-cms",
        "aurora-cms-theme",
        "cms",
        "laravel",
        "filament",
        "filament-theme",
        "admin-theme",
        "theme",
        "dark-mode",
        "tailwindcss"
    ],
    "homepage": "https://shipaurora.com",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas Alrek",
            "email": "thomas@alrek.no"
        }
    ],
    "support": {
        "issues": "https://github.com/shipaurora/borealis/issues",
        "source": "https://github.com/shipaurora/borealis"
    },
    "require": {
        "php": "^8.3",
        "shipaurora/cms": "^1.0",
        "filament/filament": "^5.10"
    },
    "replace": {
        "shipaurora/borealis-theme": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Aurora\\Borealis\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aurora\\Borealis\\ThemeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
