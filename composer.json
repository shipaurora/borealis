{
    "name": "shipaurora/borealis-theme",
    "description": "Borealis, Aurora CMS's default admin theme: its styles, design tokens and prebuilt Filament theme.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.10"
    },
    "autoload": {
        "psr-4": {
            "Aurora\\Borealis\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aurora\\Borealis\\ThemeServiceProvider"
            ]
        }
    }
}
